# Supabase — copy these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Public URL of the app (used in invite links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend email (optional). If unset, invites are created but no email is sent
# — the inviter can still copy/share the invite link manually.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Travel App <onboarding@resend.dev>

# Duffel (optional). Free test mode at duffel.com — returns realistic
# mock flight & hotel data. Live booking requires business approval.
# DUFFEL_TOKEN=duffel_test_...

# Unsplash (optional). Free at unsplash.com/developers — 50 req/hr.
# Used for the cover-photo picker on each trip.
# UNSPLASH_ACCESS_KEY=

# OpenAI (optional). https://platform.openai.com/api-keys
# Used by "Generate with AI" on the Itinerary tab. ~$0.001 per generation
# with gpt-4o-mini. Requires a paid OpenAI account (no free tier).
# OPENAI_API_KEY=
