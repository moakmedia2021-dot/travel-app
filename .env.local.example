# Supabase — copy these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Public URL of the app (used in invite links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend email (optional). If unset, invites are created but no email is sent
# — the inviter can still copy/share the invite link manually.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Travel App <onboarding@resend.dev>

# Duffel (optional). Free test mode at duffel.com — returns realistic
# mock flight & hotel data. Live booking requires business approval.
# DUFFEL_TOKEN=duffel_test_...

# Unsplash (optional). Free at unsplash.com/developers — 50 req/hr.
# Used for the cover-photo picker on each trip.
# UNSPLASH_ACCESS_KEY=

# OpenAI (optional). https://platform.openai.com/api-keys
# Used by "Generate with AI" on the Itinerary tab. ~$0.001 per generation
# with gpt-4o-mini. Requires a paid OpenAI account (no free tier).
# OPENAI_API_KEY=

# Stripe (optional). Sign up at stripe.com, create two recurring
# Products (monthly + annual), and create an endpoint webhook pointing
# at https://your-domain.com/api/stripe/webhook with these events:
#   checkout.session.completed
#   customer.subscription.updated
#   customer.subscription.deleted
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTHLY_PRICE_ID=price_...
# STRIPE_ANNUAL_PRICE_ID=price_...

# Supabase service role (required for the Stripe webhook to update
# profiles bypassing RLS). Get this from Supabase Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# PostHog (optional). Free tier covers ~1M events/month.
# Sign up at posthog.com → grab the Project API key from Settings.
# Host is us.i.posthog.com (US cloud) or eu.i.posthog.com (EU cloud).
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin allow-list for /admin/* routes (comma-separated UUIDs from
# the profiles table). Anyone not in this list gets a 404.
# ADMIN_USER_IDS=ea32d34c-2140-48bc-893f-99cb0f7bfc69

# Sentry (optional). Sign up at sentry.io, create a Next.js project,
# and paste the DSN. SDK no-ops gracefully when DSN is unset.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o.....ingest.us.sentry.io/...
# The next three are only required for source-map uploads during build.
# Get the auth token from Sentry → Settings → Account → API → Auth Tokens.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...
