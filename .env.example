# =============================================================================
# Travel App environment variables.
# Copy this to .env.local and fill in values. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# --- Required: Supabase ------------------------------------------------------
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-only — never expose to client.
# Used by the Stripe webhook to update profiles bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: App URL -------------------------------------------------------
# Public URL of the app. No trailing slash. Used in invite links + redirects.
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# Integrations — all optional. The app degrades gracefully when missing.
# =============================================================================

# --- Stripe (billing) --------------------------------------------------------
# Test keys: sk_test_..., live keys: sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# --- Duffel (flights) --------------------------------------------------------
# Test token from duffel.com → Developers → Access tokens
DUFFEL_TOKEN=

# --- Unsplash (cover photos) -------------------------------------------------
# Application access key from unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# --- OpenAI (AI itinerary generator) ----------------------------------------
# Project API key from platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Resend (transactional email) -------------------------------------------
# RESEND_API_KEY and RESEND_FROM_EMAIL together enable invite emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- PostHog (analytics) -----------------------------------------------------
# Project API key from posthog.com → Project settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (error monitoring) -----------------------------------------------
# DSN is safe to expose (write-only key)
NEXT_PUBLIC_SENTRY_DSN=
# Below three only needed for source-map uploads at build time
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Upstash Redis (rate limiting) -------------------------------------------
# Without these set, rate limiting is a no-op.
# Get from console.upstash.com → create a Redis database → "REST API" tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Admin
# =============================================================================

# Comma-separated list of profile UUIDs that can access /admin/* routes
ADMIN_USER_IDS=

# Password for the /admin portal entry gate. Defaults in code if unset.
ADMIN_PORTAL_PASSWORD=

# =============================================================================
# Pre-launch waitlist
# =============================================================================

# Set to "true" to close open signup and show the landing page at /.
# When unset/false, the app behaves normally.
WAITLIST_MODE=

# Optional: position cutoff for the "early access" progress bar on
# /waitlist/[code]. Defaults to 100 if unset.
WAITLIST_EARLY_ACCESS_THRESHOLD=
